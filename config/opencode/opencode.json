{
  "$schema": "https://opencode.ai/config.json",
  "model": "local/local-primary",
  "small_model": "local/local-primary",
  "autoupdate": false,
  "share": "disabled",
  "snapshot": false,
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local model server",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1"
      },
      "models": {
        "local-primary": {
          "name": "local-primary",
          "limit": {
            "context": 131072,
            "output": 32768
          },
          "reasoning": true,
          "tool_call": true
        }
      }
    }
  },
  "permission": {
    "webfetch": "deny",
    "websearch": "deny"
  },
  "skills": {
    "paths": [
      "~/agent-data/work/skills"
    ]
  }
}
