# Pins for the agent's local web search (increment 10), read by scripts/web/setup-web.sh.
AGENTWEB_USER=agentweb
AGENTWEB_HOME=/var/lib/agentweb
SEARXNG_REPO=https://github.com/searxng/searxng.git
SEARXNG_COMMIT=ef7bae9ddbec3f4e6690595adf793acf601e9884
# SearXNG needs Python 3.11 or newer (it imports tomllib); uv installs this build, checksum-verified.
PYTHON_VERSION=3.12.13
UV_VERSION=0.11.19
