# Settings for the local model server. serve.sh reads this file and
# scripts/serve/verify.sh checks the installed versions against it.
# Change a value only for a measured reason, and record why in DEVLOG.md.

# Pinned software
PYTHON_VERSION=3.12.13
VLLM_VERSION=0.31.0
TORCH_VERSION=2.13.0
FLASHINFER_VERSION=0.7.0.post1
TRANSFORMERS_VERSION=5.17.0

# Pinned model
MODEL_REPO=Qwen/Qwen3.8-27B-FP8
MODEL_REVISION=017b9c7af6b5689d5dd426a76e0bc077eb5ca20a
SERVED_NAME=local-primary

# Server. Thinking effort is left at the model's default, xhigh; a request
# can lower it with chat_template_kwargs {"reasoning_effort": "medium"}.
HOST=127.0.0.1
PORT=8000
MAX_MODEL_LEN=131072
MAX_NUM_SEQS=4
GPU_MEMORY_UTILIZATION=0.80
# 16-bit cache: the checkpoint ships no calibrated FP8 cache scales, so an
# FP8 cache would use a default scale of 1.0. FP8 is an option to test, not
# the default.
KV_CACHE_DTYPE=auto
SPECULATIVE_CONFIG='{"method":"mtp","num_speculative_tokens":3}'
LIMIT_MM_PER_PROMPT='{"image":2}'
REASONING_PARSER=qwen3
TOOL_CALL_PARSER=qwen3_coder
SEED=0
