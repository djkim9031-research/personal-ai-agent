# Template for /etc/systemd/system/agent-searxng.service, rendered by
# scripts/web/setup-web.sh. SearXNG on 127.0.0.1:8888 for the agent's fetch
# service, as the agentweb user; starts and stops with the gateway.
[Unit]
Description=SearXNG for the agent's web search (agentweb user)
PartOf=agent-hermes.service
After=agent-web-egress.service
Requires=agent-web-egress.service

[Service]
Type=simple
User=agentweb
Group=agentweb
WorkingDirectory=@WEB_HOME@
Environment=HOME=@WEB_HOME@ SEARXNG_SETTINGS_PATH=@WEB_HOME@/settings.yml PYTHONPATH=@WEB_HOME@/searxng
EnvironmentFile=@WEB_HOME@/secret.env
ExecStart=@WEB_HOME@/venv/bin/granian --interface wsgi --host 127.0.0.1 --port 8888 --workers 1 searx.webapp:app
Restart=on-failure
RestartSec=10
UMask=0077
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=@WEB_HOME@
PrivateTmp=yes
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes

[Install]
WantedBy=agent-hermes.service
