# Template for /etc/systemd/system/agent-vllm.service, rendered by
# scripts/serve/setup-service.sh, which fills in the @...@ values.
[Unit]
Description=Local model server for the personal agent (vLLM)
After=network.target
# Give up after 3 failed starts in 30 minutes instead of holding the GPU in a loop.
StartLimitIntervalSec=30min
StartLimitBurst=3

[Service]
Type=exec
User=agent-serve
Group=agent-serve
WorkingDirectory=@SERVE_HOME@
Environment=HOME=@SERVE_HOME@
Environment=XDG_CACHE_HOME=@SERVE_HOME@/.cache
Environment=TMPDIR=@SERVE_HOME@/tmp
Environment=AGENT_VENV=@AGENT_VENV@
Environment=AGENT_MODEL=@AGENT_MODEL@
ExecStartPre=/usr/bin/test -c /dev/nvidia-uvm
ExecStart=@REPO@/config/vllm/serve.sh
# "systemctl start" returns once the model answers, or fails after 30 minutes.
ExecStartPost=/bin/sh -c 'until /usr/bin/curl -fsS -o /dev/null --max-time 5 http://127.0.0.1:@PORT@/health; do sleep 5; done'
TimeoutStartSec=30min
# vLLM exits with status 0 when its engine dies, so restart on any exit.
# A manual "systemctl stop" never triggers a restart.
Restart=always
RestartSec=30
KillMode=mixed
TimeoutStopSec=90
LimitNOFILE=65536
UMask=0077

# /home looks empty to the service except for what it needs: its own home,
# writable, and the runtime, the model and the serve settings, read-only.
ProtectHome=tmpfs
BindPaths=@SERVE_HOME@
BindReadOnlyPaths=@RUNTIME@ @AGENT_MODEL@ @REPO@/config/vllm
ProtectSystem=strict
PrivateTmp=yes
RemoveIPC=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes

[Install]
WantedBy=multi-user.target
