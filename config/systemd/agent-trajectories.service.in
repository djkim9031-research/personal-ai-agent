# Template for /etc/systemd/system/agent-trajectories.service, rendered by
# scripts/agent-memory/enable-memory.sh. The owner's nightly job: files the agent's
# exported sessions and memory into ~/agent-data and exports the opencode
# window sessions. Runs as the owner, with no network.
[Unit]
Description=Agent trajectories and memory into the owner's data folder (nightly)
After=agent-memory-nightly.service

[Service]
Type=oneshot
User=@OWNER_UID@
Group=@OWNER_GID@
Environment=HOME=@OWNER_HOME@ AGENT_OUTBOX=@HERMES_HOME@/outbox
ExecStart=/usr/bin/python3 -I @REPO@/scripts/agent-memory/collect-trajectories.py
TimeoutStartSec=30min
PrivateNetwork=yes
ProtectSystem=full
PrivateTmp=yes
NoNewPrivileges=yes
