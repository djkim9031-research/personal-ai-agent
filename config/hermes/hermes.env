# Hermes Agent, its sandbox and its user, pinned. Read by scripts/shell/*.sh.
HERMES_USER=hermes
HERMES_HOME_DIR=/home/hermes
# Subordinate IDs for rootless Docker; 100000-231071 belong to other accounts here.
HERMES_SUBID_START=231072
HERMES_SUBID_COUNT=65536

# v0.22.5 (2026-10-22); v0.21.6 fixed an email allowlist bypass, so never older.
HERMES_VERSION=v0.22.5
HERMES_COMMIT=bf0203a794a07aac3ff764972ab9087baa4e4f4e
# scripts/install.sh at that commit, read before use; the copy served from the
# project site is newer and differs.
HERMES_INSTALLER_SHA256=99cb3691d55019c6973a7acb775a915648666cc24e483ca827a1cdbb3531a674

# Docker's static release, for the hermes user only; the system Docker is not touched.
# Hashes recorded at first download (Docker publishes none for these files).
DOCKER_VERSION=29.8.1
DOCKER_STATIC_SHA256=d8db66739d2e28d4933786d73e918d9be643a67fbd835db1bf740d650a259e70
DOCKER_ROOTLESS_SHA256=8f1ed16fc6913241e599af6234a7f30502bde6e73bebbbc7176b17802d967d49

# The container the model's commands run in, with no network.
SANDBOX_IMAGE=python:3.12-slim-bookworm@sha256:6a0e06f5ba0b373d051aabd3fffb9b873f27f9a2a3a14bcbe37dee6f0e3bbc70
