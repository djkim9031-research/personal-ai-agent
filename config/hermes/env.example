# The email lines of the hermes user's ~/.hermes/.env (mode 0600), written by
# scripts/shell/set-mail-secret.sh. The two addresses come from the private file
# ~/agent-data/secrets/hermes-mail.env, the password from the private file
# ~/agent-data/secrets/agent-gmail-app-password; neither is ever committed.
EMAIL_ADDRESS=agent-mailbox@example.com
EMAIL_PASSWORD=<app password, never typed here>
EMAIL_ALLOWED_USERS=owner@example.com
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
# 587 is closed on this network; 465 is implicit TLS.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
# Mail is acted on only when Gmail's own Authentication-Results line passes.
EMAIL_AUTHSERV_ID=mx.google.com
EMAIL_POLL_INTERVAL=15
